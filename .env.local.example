# Copie este arquivo para .env.local e preencha com as chaves do seu projeto
# no Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada somente no servidor por scripts administrativos e jobs agendados.
SUPABASE_SERVICE_ROLE_KEY=

# Envio das propostas pelo Microsoft 365 / Microsoft Graph.
# São variáveis SOMENTE de servidor: nunca use prefixo NEXT_PUBLIC_.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

# Relatório diário de governança de marcas.
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
RELATORIO_MARCAS_EMAILS=
